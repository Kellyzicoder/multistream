{
  "name": "multistream",
  "version": "3.0.0",
  "description": "Multistream 3: make the show in the Studio and send it to Facebook, YouTube and Instagram at the same time. Nothing runs on localhost unless you switch it on.",
  "main": "main.js",
  "author": "Kelvin Mensah",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder",
    "test": "node test/unit.js",
    "test:app": "node test/app.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "flv.js": "^1.6.2",
    "ws": "^8.18.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "1.48.2"
  },
  "build": {
    "appId": "com.multistream.app.v3",
    "productName": "Multistream 3",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "flvhub.js",
      "inproc.js",
      "stats.js",
      "recorder.js",
      "chat.js",
      "autoretry.js",
      "preflight.js",
      "encoder.js",
      "public/**/*",
      "package.json",
      "vcam.js"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "vcam/win",
          "to": "vcam",
          "filter": [
            "softcam.dll",
            "softcam_installer.exe",
            "vcam.exe"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Multistream3-Setup.exe"
    },
    "dmg": {
      "artifactName": "Multistream3-Mac-${arch}.dmg"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "Multistream3-Linux.AppImage",
      "category": "AudioVideo"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "extendInfo": {
        "NSCameraUsageDescription": "Multistream uses cameras and capture cards in the Studio.",
        "NSMicrophoneUsageDescription": "Multistream uses audio inputs (like the mixing desk) in the Studio."
      }
    },
    "afterPack": "adhoc-sign.js",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Kellyzicoder/multistream/releases/download/v3-latest"
      }
    ]
  }
}
